{
	"name": "@drumr/framework-backend",
	"version": "1.0.0-beta.14",
	"description": "Drumr Framework - Backend (models, actions, GraphQL, datasources)",
	"publishConfig": {
		"registry": "https://us-central1-npm.pkg.dev/future-name-492914-n5/drumr-npm/",
		"access": "restricted"
	},
	"main": "./dist/cjs/backend/index.js",
	"types": "./dist/cjs/backend/index.d.ts",
	"bin": {
		"drumr-generate-actions": "./dist/cjs/backend/src/action/generateActionsIndexCLI.js"
	},
	"files": [
		"dist/cjs/**/*",
		"skills/**/*",
		"README.md"
	],
	"exports": {
		".": {
			"types": "./dist/cjs/backend/index.d.ts",
			"import": "./dist/cjs/backend/index.js",
			"require": "./dist/cjs/backend/index.js",
			"default": "./dist/cjs/backend/index.js"
		}
	},
	"scripts": {
		"test": "npm run test:sqlite && npm run test:postgres && npm run test:integration",
		"test:sqlite": "cross-env TEST_DB=sqlite LOG_LEVEL=error jest --config jest.config.ts --forceExit",
		"test:postgres": "cross-env TEST_DB=postgres LOG_LEVEL=error jest --config jest.config.ts --forceExit",
		"test:integration": "cross-env TEST_DB=postgres LOG_LEVEL=error jest --config jest.integration.config.js --forceExit",
		"test:integration:gcs": "node scripts/run-gcs-integration-emulator.js",
		"test:single": "cross-env LOG_LEVEL=error jest --config jest.config.ts --verbose",
		"biome:check": "npx @biomejs/biome check .",
		"biome:check:errors": "npx @biomejs/biome check . --diagnostic-level=error",
		"biome:format": "npx @biomejs/biome format .",
		"biome:lint": "npx @biomejs/biome lint .",
		"typecheck": "tsc --project tsconfig.json --noEmit",
		"watch": "tsc --project tsconfig.build.json --watch",
		"build": "npm run build:cjs && npm run build:package-json && npm run build:skills",
		"build:cjs": "tsc --project tsconfig.build.json",
		"build:package-json": "node scripts/create-dist-package-json.js",
		"build:skills": "node scripts/copy-skills.js",
		"clean": "rimraf dist coverage .tsbuildinfo skills"
	},
	"author": "Drumr",
	"license": "Apache-2.0",
	"engines": {
		"node": ">=20.0.0",
		"npm": ">=10.0.0"
	},
	"dependencies": {
		"@apollo/server": "^5.0.0",
		"@as-integrations/express5": "^1.1.2",
		"@casl/ability": "^6.7.3",
		"@dbos-inc/dbos-sdk": "^4.7.9",
		"@dbos-inc/typeorm-datasource": "^4.7.9",
		"@google-cloud/storage": "^7.19.0",
		"@pothos/core": "^4.10.0",
		"@slingr/financial-arithmetic-functions": "latest",
		"@types/bcryptjs": "^2.4.6",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/passport-jwt": "^4.0.1",
		"@ucast/core": "^1.10.2",
		"@ucast/mongo": "^2.4.3",
		"@ucast/mongo2js": "^1.4.0",
		"acorn": "^8.16.0",
		"acorn-walk": "^8.3.5",
		"bcryptjs": "^3.0.2",
		"class-transformer": "^0.5.1",
		"class-validator": "^0.14.2",
		"cors": "^2.8.5",
		"cron-parser": "^5.5.0",
		"dotenv": "^16.4.7",
		"express": "^5.2.1",
		"express-jwt": "^8.5.1",
		"fastify": "^5.8.5",
		"financial-number": "^4.0.4",
		"glob": "^11.0.3",
		"graphql-tag": "^2.12.6",
		"jsonwebtoken": "^9.0.2",
		"multer": "^2.0.2",
		"passport-jwt": "^4.0.1",
		"reflect-metadata": "^0.2.2",
		"tsyringe": "^4.8.0",
		"typeorm": "^0.3.26",
		"uuid": "^14.0.0",
		"winston": "^3.18.3",
		"winston-daily-rotate-file": "^5.0.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.10",
		"@jest/globals": "^30.3.0",
		"@playwright/test": "^1.58.2",
		"@types/cors": "^2.8.19",
		"@types/dotenv": "^8.2.0",
		"@types/express": "^5.0.3",
		"@types/glob": "^8.1.0",
		"@types/jest": "^29.5.12",
		"@types/multer": "^2.0.0",
		"@types/node": "^24.10.13",
		"@types/pg": "^8.15.5",
		"@types/sqlite3": "^3.1.11",
		"@types/supertest": "^6.0.2",
		"@types/uuid": "^10.0.0",
		"cross-env": "^10.1.0",
		"dayjs": "^1.11.19",
		"jest": "^30.2.0",
		"jest-circus": "^30.2.0",
		"mysql2": "^3.11.3",
		"pg": "^8.16.3",
		"rimraf": "^6.0.1",
		"sqlite3": "^5.1.7",
		"supertest": "^7.0.0",
		"ts-jest": "^29.4.4",
		"ts-node": "^10.9.2",
		"tsc-alias": "^1.8.16",
		"typescript": "^5.9.2"
	},
	"overrides": {
		"glob": "^11.0.3",
		"node-gyp": "^11.0.0",
		"esbuild": "0.21.4"
	}
}
