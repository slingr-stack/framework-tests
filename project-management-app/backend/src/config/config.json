{
	"graphql": {
		"host": "${HOST:localhost}",
		"port": "${PORT:3000}",
		"enableExplorer": "${GRAPHQL_ENABLE_EXPLORER:false}"
	},
	"auth": {
		"enabled": true,
		"basePath": "/auth"
	},
	"metadata": {
		"name": "project-management-app",
		"version": "1.0.0",
		"description": "A comprehensive demo app showcasing Drumr framework capabilities for project and task management"
	},
	"workflows": {
		"enabled": true,
		"dataSource": "${WORKFLOWS_DATA_SOURCE:mainDs}",
		"pruneThresholdDays": "${WORKFLOWS_PRUNE_THRESHOLD_DAYS:7}",
		"pruningIntervalSeconds": "${WORKFLOWS_PRUNING_INTERVAL_SECONDS:3600}"
	},
	"distributedLocks": {
		"provider": "${DISTRIBUTED_LOCKS_PROVIDER:memory}",
		"dataSource": "${DISTRIBUTED_LOCKS_DATASOURCE:mainDs}"
	},
	"email": {
		"host": "${SMTP_HOST:}",
		"port": "${SMTP_PORT:587}",
		"secure": "${SMTP_SECURE:false}",
		"user": "${SMTP_USER:}",
		"password": "${SMTP_PASSWORD:}",
		"from": "${SMTP_FROM:noreply@drumr.io}"
	}
}
