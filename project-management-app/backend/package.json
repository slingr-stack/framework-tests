{
	"name": "project-management-app",
	"version": "1.0.0",
	"description": "A comprehensive demo app showcasing Drumr framework capabilities for project and task management",
	"scripts": {
		"build": "tsc --build && tsc-alias -p tsconfig.json --resolve-full-paths",
		"dev": "ts-node src/App.ts",
		"setup": "pnpm install && npx drumr gql generate-schema && npx drumr gql generate-sdk",
		"test": "cross-env TS_NODE_PROJECT=tsconfig.test.json jest --config config/jest.config.ts",
		"test:unit": "cross-env TS_NODE_PROJECT=tsconfig.test.json jest --config config/jest.config.ts --testPathPatterns='tests/unit'",
		"test:integration": "cross-env TS_NODE_PROJECT=tsconfig.test.json jest --config config/jest.config.ts --testPathPatterns='tests/integration'",
		"test:watch": "cross-env TS_NODE_PROJECT=tsconfig.test.json jest --config config/jest.config.ts --watch",
		"test:skill-conformance": "cross-env TS_NODE_PROJECT=tsconfig.test.json jest --config config/jest.config.ts --testPathPatterns='skill-conformance' --no-coverage",
		"test:skill-conformance:ci": "cross-env TS_NODE_PROJECT=tsconfig.test.json jest --config config/jest.config.ts --testPathPatterns='skill-conformance' --no-coverage --json --outputFile=skill-conformance-results.json"
	},
	"keywords": [
		"drumr",
		"project-management",
		"demo"
	],
	"author": "Drumr Team",
	"license": "MIT",
	"dependencies": {
		"@drumr/framework-backend": "1.0.0-beta.14",
		"graphql-request": "^7.3.0",
		"nodemailer": "^8.0.5",
		"pdfkit": "^0.17.2",
		"pg": "^8.17.2",
		"reflect-metadata": "^0.2.2"
	},
	"devDependencies": {
		"@casl/ability": "6.7.3",
		"@graphql-codegen/cli": "^6.0.0",
		"@graphql-codegen/typescript": "^5.0.2",
		"@graphql-codegen/typescript-graphql-request": "^7.0.0",
		"@graphql-codegen/typescript-operations": "^5.0.2",
		"@types/bcryptjs": "^2.4.6",
		"@types/express": "^5.0.6",
		"@types/jest": "^29.5.12",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/node": "^24.3.0",
		"@types/nodemailer": "^8.0.0",
		"@types/pdfkit": "^0.17.4",
		"@types/supertest": "^6.0.3",
		"bcryptjs": "^3.0.2",
		"cross-env": "^7.0.3",
		"jest": "^30.2.0",
		"jsonwebtoken": "^9.0.2",
		"supertest": "^7.2.2",
		"ts-jest": "^29.4.5",
		"ts-node": "^10.9.2",
		"tsc-alias": "^1.8.10",
		"tsconfig-paths": "^4.2.0",
		"tsx": "^4.21.0",
		"typescript": "^5.9.2"
	},
	"overrides": {
		"glob": "^11.0.0",
		"node-gyp": "^11.0.0"
	}
}
