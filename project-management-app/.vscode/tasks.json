{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "drumr: run environment",
			"type": "shell",
			"command": "drumr run",
			"isBackground": true,
			"presentation": {
				"reveal": "always",
				"panel": "new"
			},
			"problemMatcher": {
				"owner": "drumr-runner",
				"pattern": {
					"regexp": ".*"
				},
				"background": {
					"activeOnStart": true,
					"beginsPattern": "^(Starting infrastructure services...)",
					"endsPattern": "^(\\w+) application initialized"
				}
			}
		}
	]
}
